backend/data/trust.db
backend/data/trust.db-wal
backend/data/trust.db-shm
backend/data/server.lock
backend/data/cache/
backend/data/config.json
backend/data/*.log
backend/data/t.sh
backend/data/si*.log

# 根级运行时数据（job_id 记录等）
data/
!data/.gitkeep

# ---- 前端 ----
node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# ---- 第三方二进制（51MB，按 docs 安装说明单独获取）----
tools/libredwg/

