# Fidelity on the Mac mini (Phase 6). Copy to deploy/mac/mac.env (git-ignored) and adjust.
QA_SERVER_HOST=127.0.0.1          # 0.0.0.0 to serve the office network (put it behind the office firewall)
QA_SERVER_PORT=8000
FIDELITY_VISUAL_SAMPLES=all       # visual cross-check on every page
FIDELITY_FORMULA_OCR=1            # read unreadable formulas -> candidates for review
FIDELITY_LLM_URL=http://127.0.0.1:11434
FIDELITY_LLM_MODEL=qwen2.5:7b-instruct
# Server database (optional; SQLite in data/ otherwise). Keep passwords only in this file.
# FIDELITY_DB_URL=postgresql+asyncpg://fidelity:<password>@127.0.0.1:5432/fidelity
# FIDELITY_TRUST_URL=postgresql://fidelity:<password>@127.0.0.1:5432/fidelity
