<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fidelity.app</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__ROOT__/deploy/mac/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>__ROOT__/backend</string>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/app.out.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/app.err.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
