# Fidelity container settings. Copy to deploy/docker/fidelity.env (git-ignored) and adjust.

# --- Database: PostgreSQL on this Mac (recommended). Create the role and database first (runbook).
# Without these two lines the container uses SQLite inside its data volume.
FIDELITY_DB_URL=postgresql+asyncpg://fidelity:CHANGE-ME@host.docker.internal:5432/fidelity
FIDELITY_TRUST_URL=postgresql://fidelity:CHANGE-ME@host.docker.internal:5432/fidelity

# --- Quality settings
FIDELITY_VISUAL_SAMPLES=3            # pages per document checked visually; "all" = every page (slower)

# --- Local correction model: Ollama installed natively on the Mac (uses the Apple GPU), optional
# FIDELITY_LLM_URL=http://host.docker.internal:11434
# FIDELITY_LLM_MODEL=qwen2.5:7b-instruct
